{
  "name": "tennis-umpire",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node --input-type=module -e \"import { writeFileSync } from 'node:fs'; writeFileSync('docs/.nojekyll', '');\"",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
